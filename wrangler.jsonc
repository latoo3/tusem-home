// Cloudflare ayarı: build sonrası dist/ klasöründeki statik site yayınlanır.
// worker/index.js sadece admin panelinin GitHub girişini (/oauth/...) yönetir.
{
  "name": "tusem-home",
  "compatibility_date": "2025-11-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/oauth/*"]
  },
  // Cloudflare panelinden eklenen ayarlar her yayında silinmesin.
  "keep_vars": true
}
