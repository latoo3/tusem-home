---
import { kucukImg, baslikYap, type Kategori } from '../lib/catalog';

interface Props { kategori: Kategori }
const { kategori } = Astro.props;
const kapak = kategori.kapak ?? kategori.urunler.find((u) => u.gorsel)?.gorsel ?? null;
---
<a href={`/${kategori.slug}`} class="card">
  <div class={`card-img ${kategori.kapak ? 'cover' : ''}`}>
    <img src={kucukImg(kapak)} alt={baslikYap(kategori.ad)} width="600" height="600" loading="lazy" decoding="async" />
  </div>
  <div class="card-body">
    <span class="card-title">{baslikYap(kategori.ad)}</span>
    <span class="note">{kategori.urunler.length} ürün</span>
  </div>
</a>
