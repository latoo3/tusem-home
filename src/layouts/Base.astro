---
import '../styles/global.css';
import { site, img, whatsappLink } from '../lib/catalog';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
}
const { title, description = site.meta.anasayfa.aciklama, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(img(image ?? site.logo), Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const menu = [
  { href: '/', ad: 'Anasayfa' },
  { href: '/urunler', ad: 'Ürünler' },
  { href: '/yenieklenenler', ad: 'Yeni Eklenenler' },
  { href: '/tusemhomeiletisim', ad: 'İletişim' },
];
const yil = new Date().getFullYear();
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.ad} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="tr_TR" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Store',
      name: site.ad,
      url: Astro.site?.toString(),
      telephone: site.telefon_whatsapp[0],
      email: site.eposta[0],
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'İstoç Ticaret Merkezi, 3. Ada, 2419. Sk. No:142',
        postalCode: '34218',
        addressLocality: 'Bağcılar',
        addressRegion: 'İstanbul',
        addressCountry: 'TR',
      },
      openingHours: ['Mo-Fr 07:30-17:30', 'Sa 07:30-14:00'],
      sameAs: [site.instagram],
    })} />
  </head>
  <body>
    <header class="header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Tusem Home anasayfa">
          <img src={img(site.logo)} alt="Tusem Home" width="180" height="60" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'logo-text',textContent:'Tusem Home'}))" />
        </a>
        <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Menüyü aç" />
        <label for="menu-toggle" class="menu-button" aria-hidden="true"><span></span><span></span><span></span></label>
        <nav class="nav">
          {menu.map((m) => (
            <a href={m.href} aria-current={path === m.href ? 'page' : undefined}>{m.ad}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div>
          <h2>Adres</h2>
          <p>{site.adres}</p>
          <h2>Çalışma saatleri</h2>
          <p>Hafta içi: {site.calisma_saatleri.hafta_ici}<br />Cumartesi: {site.calisma_saatleri.cumartesi}</p>
        </div>
        <div>
          <h2>İletişim</h2>
          <p>
            Telefon / WhatsApp:<br />
            {site.telefon_whatsapp.map((t) => (
              <><a href={`tel:${t.replace(/\s/g, '')}`}>{t}</a><br /></>
            ))}
          </p>
          <p>
            E-posta:<br />
            {site.eposta.map((e) => (
              <><a href={`mailto:${e}`}>{e}</a><br /></>
            ))}
          </p>
          <p><a href={site.instagram} target="_blank" rel="noopener">Instagram: @tusemhome</a></p>
        </div>
        <div>
          <h2>Harita</h2>
          <iframe
            src={site.harita}
            title="Tusem Home konumu"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
      <p class="copyright">Tusem Home © {yil} Tüm hakları saklıdır.</p>
    </footer>

    <a
      class="wa-float"
      href={whatsappLink('Merhaba, ürünleriniz hakkında bilgi almak istiyorum.')}
      target="_blank"
      rel="noopener"
      aria-label="WhatsApp ile yazın"
    >
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.6c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 .8.4 1.4.6 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.8-.4Z"/></svg>
      <span>WhatsApp</span>
    </a>
  </body>
</html>
